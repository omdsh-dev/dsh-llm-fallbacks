# dsh profile convention: the @deepseek-ai/* and cordis peer dependencies
# resolve from the dsh installation at runtime (in-box bundles), never from
# the npm registry. autoInstallPeers=false + nodeLinker=hoisted live in
# pnpm-workspace.yaml (pnpm 11+ ignores non-auth settings in .npmrc).
# Dev-time resolution of the private packages is wired by
# scripts/setup-dsh-links.mjs from the $DSH_SOURCE_DIR / $DSH_HOME source
# tree (see README, Development).

@deepseek-ai:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
