# @deepseek-ai/* peer dependencies resolve from the npm registry (restricted
# scope) via the NPM_TOKEN env var. autoInstallPeers=true + nodeLinker=hoisted
# live in pnpm-workspace.yaml (pnpm 11+ ignores non-auth settings in .npmrc).

@deepseek-ai:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
