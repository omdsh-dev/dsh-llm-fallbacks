    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["bun-types", "react"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
