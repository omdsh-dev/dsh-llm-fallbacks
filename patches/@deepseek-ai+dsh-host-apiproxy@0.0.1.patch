index 331b0716ba61da51881da244a5f78c5c0984f026..fb425de65e2a9860d495c6f7d1b55a61cf762d87 100644
--- a/packages/host/apiproxy/src/api-proxy.ts
+++ b/packages/host/apiproxy/src/api-proxy.ts
@@ -1719,6 +1719,26 @@ export function createApiProxy(ctx: Context, defaults: ApiProxyDefaults): ApiPro
     const exposed = modelProviderNamespaces()
     for (const ns of WEB_SETTINGS_NAMESPACES) exposed.add(ns)
     for (const ns of PRODUCT_SETTINGS_NAMESPACES) exposed.add(ns)
+    // Registration-level opt-in: a namespace whose owner declared
+    // `exposeToWebClients` joins the configuration-client boundary. Read
+    // through the seam's own describe so the flag can never drift from the
+    // registrant's declaration; without a settings service nothing is added.
+    // simplify: reads describe() wholesale per RPC (O(#registrations) per
+    // call); a settings-side metadata face (direct registry query) is the
+    // upgrade path, left to upstream evolution.
+    const settings = ctx.get('settings')
+    if (settings !== undefined) {
+      try {
+        for (const descriptor of settings.describe({ redactSecrets: true })) {
+          if (typeof descriptor.ns !== 'string') continue
+          if (descriptor.exposed === true) exposed.add(descriptor.ns)
+        }
+      } catch {
+        // A single registration's describe throwing must not take down the
+        // whole exposed union — the namespace simply stays out of the
+        // configuration-client boundary.
+      }
+    }
     return exposed
   }
 
