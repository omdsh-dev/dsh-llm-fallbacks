+/** Config objects whose provider/model routing was already decided by an outer
+ * coordinator (e.g. a fallback plugin) for this request step. */
+const fallbackRouted = new WeakSet<LlmCallConfig>()
+
+/** Mark a resolved request config as fallback-routed for this step. */
+export function markFallbackRouted(config: LlmCallConfig): LlmCallConfig {
+  fallbackRouted.add(config)
+  return config
+}
+
+/** Whether the resolved config was marked fallback-routed (coordinator-owned routing). */
+export function isFallbackRouted(config: LlmCallConfig): boolean {
+  return fallbackRouted.has(config)
+}
